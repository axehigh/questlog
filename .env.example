# Deployment destination only; never put passwords, tokens or private keys here.
# Use literal unquoted values, with no spaces around =.
SFTP_OLONA=YOUR_USER@YOUR_SFTP_HOST
SFTP_OLONA_DIR=/path/to/questlog
# Leave this reference unchanged. The actual password comes ONLY from the
# exported system environment variable SFTP_OLONA_PW; unset/empty uses keys/agent.
# This file is parsed literally, not sourced or expanded as shell code.
SFTP_OLONA_PW=${SFTP_OLONA_PW}
